# Attestor — environment
#
# Copy to `.env` and edit only if you are deviating from the defaults. Every value
# below has a working default, which is why the Quickstart needs no configuration:
# `attestor run` offline reads recorded values and never contacts AWS.
#
# Nothing here is a credential. There is no long-lived AWS key anywhere in this
# project — humans authenticate by SSO, CI by GitHub OIDC, services by execution
# role. A static key in this file would fail the build.

# ─── Where figures come from ──────────────────────────────────────────────────
# recorded : replay the values captured in build/recordings — offline, deterministic,
#            the default and what CI uses.
# athena   : resolve against live Iceberg tables. Requires AWS credentials and a
#            deployed `data` layer.
ATTESTOR_BACKEND=recorded

# Narrative extraction, same two modes as above.
ATTESTOR_EXTRACTOR=recorded

# ─── Athena, when ATTESTOR_BACKEND=athena ─────────────────────────────────────
ATTESTOR_CATALOG=AwsDataCatalog
ATTESTOR_DATABASE=attestor_gold
AWS_REGION=eu-central-1

# ─── Reporting scope ──────────────────────────────────────────────────────────
# The reporting period every contract resolves against.
ATTESTOR_PERIOD=2026

# The tenant the AgentCore runtime serves. Deliberately empty by default: an
# unscoped tenant is a refusal, not a wildcard. Terraform sets this per runtime.
ATTESTOR_TENANT=

# ─── AgentCore runtime only ───────────────────────────────────────────────────
# Set inside the container image; you do not need these to run locally.
ATTESTOR_PROJECT=attestor
ATTESTOR_ROOT=/var/task
PORT=8080
