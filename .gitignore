# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Terraform
.terraform/
# `.terraform.lock.hcl` IS committed. Provider versions that resolve differently between
# a validation run and a deploy make "validated" mean nothing.
*.tfstate
*.tfstate.*
*.tfplan
crash.log
override.tf
override.tf.json

# Secrets — never
.env
.env.*
# The one exception: it documents the settings and their defaults, and holds no value.
# Named explicitly rather than by pattern, so a `.env.local` can never slip through with it.
!.env.example
*.pem
*.key
credentials.json
.bootstrap_outputs.json

# Build output — reports are generated, never committed
out/
build/
dist/

# Evidence corpora are synthetic but bulky; only the manifests are committed
evals/**/corpus/**/*.pdf
evals/**/corpus/**/*.bin

# Lambda payloads are vendored by `make package` and zipped by terraform. A committed
# artefact drifts from the source it was built from, and the drift is invisible.
infra/*/.build/
infra/agent/tools/*
!infra/agent/tools/handler.py

# macOS
.DS_Store

# Personal notes — a reading aid, never published and never part of the repository's
# public surface. The folder is ignored rather than the file, so anything else that goes in
# later is covered by the same decision instead of needing a new one.
notes/

# Promo material — shot lists, clips, music, the production guide. Large binaries and a
# marketing artefact; neither belongs in a repository whose whole claim is that everything
# in it is checkable.
promo/
.venv-checkov/

# Personal marketing material, not part of the product.
linkedin/
